# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에_anon_key_입력
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_key_입력

# Anthropic (AI 프로필 자동생성, 환자-의사 매칭)
ANTHROPIC_API_KEY=sk-ant-...

# Vercel AI Gateway (선택 — AI Gateway 사용 시)
AI_GATEWAY_API_KEY=여기에_gateway_key_입력

# 이메일 (Resend — 도메인 활성화 후 필요)
RESEND_API_KEY=re_...
RESEND_FROM=hello@magom.io

# 사이트 URL (로컬 개발 시)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
